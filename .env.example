# Target Company Outreach Scout - Environment Config

# Optional: Google Custom Search API (for higher throughput if available)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional: SerpAPI Key (fallback search engine)
SERPAPI_KEY=

# Search Settings
DEFAULT_MAX_RESULTS_PER_COMPANY=5
SEARCH_DELAY_SECONDS=1.5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
